# AyurVoice SaaS Environment Configuration
PROJECT_NAME="AyurVoice SaaS"
SECRET_KEY="your-secret-key-generate-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite local dev: sqlite+aiosqlite:///./ayurvoice.db
# For PostgreSQL production: postgresql+asyncpg://postgres:postgrespassword@postgres:5432/ayurvoice
DATABASE_URL="sqlite+aiosqlite:///./ayurvoice.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
ENABLE_CELERY=false

# Public Server Base URL
BASE_URL="http://localhost:8000"

# ElevenLabs Conversational AI Credentials
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_PHONE_NUMBER_ID=""

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

