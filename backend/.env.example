# ==============================================================================
# AyurVoice SaaS - Environment Configuration
# ==============================================================================

# Application & Security
PROJECT_NAME="AyurVoice SaaS"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BASE_URL="http://localhost:8000"

# Multi-Tenant PostgreSQL Database
# Local SQLite fallback: sqlite+aiosqlite:///./ayurvoice.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ayurvoice"

# Redis & Celery Queue
REDIS_URL="redis://localhost:6379/0"

# ElevenLabs Conversational AI Credentials
# Get from https://elevenlabs.io/app/conversational-ai
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
ELEVENLABS_AGENT_ID="your-conversational-ai-agent-id"
ELEVENLABS_PHONE_NUMBER_ID=""

# Twilio Telephony Credentials
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+18005550199"

# Frontend CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

